# Servidor
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=troque-esta-chave-secreta-jwt-super-segura
JWT_REFRESH_SECRET=troque-esta-chave-secreta-refresh-super-segura

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app-gmail
EMAIL_FROM=Sistema Estoque TI <noreply@farmarcas.com.br>
EMAIL_TI=ti@farmarcas.com.br

# JIRA (criação de tarefa após confirmar pedido)
JIRA_URL=https://seu-dominio.atlassian.net
JIRA_USER=seu-email@farmarcas.com.br
JIRA_TOKEN=seu-jira-api-token
JIRA_PROJECT_KEY=TI

# Segurança dos Webhooks (enviar este token no header x-webhook-secret)
WEBHOOK_SECRET=webhook-secret-token-seguro

# Senhas de Seed (para inicialização do banco)
SEED_ADMIN_PASSWORD=
SEED_TI_PASSWORD=
SEED_PATRIMONIO_PASSWORD=
